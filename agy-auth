#!/usr/bin/env python3
"""
Antigravity Profile Switcher (agy-auth)
Production-grade CLI tool to manage, switch, and secure Antigravity accounts.
"""

import sys
import os
import re
import json
import time
import base64
import shutil
import argparse
import subprocess
import sqlite3
import tarfile
import tempfile
from datetime import datetime

GEMINI_DIR = os.path.expanduser("~/.gemini/antigravity-cli")
TOKEN_FILE = os.path.join(GEMINI_DIR, "antigravity-oauth-token")
PROFILES_DIR = os.path.join(GEMINI_DIR, "profiles")
CONVERSATIONS_DIR = os.path.join(GEMINI_DIR, "conversations")
SUMMARIES_DB = os.path.join(GEMINI_DIR, "conversation_summaries.db")
BRAIN_DIR = os.path.join(GEMINI_DIR, "brain")

NAME_REGEX = re.compile(r"^[a-zA-Z0-9_\-\.]+$")
UUID_REGEX = re.compile(r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")

def validate_name(name):
    if not name or not NAME_REGEX.match(name) or name in (".", ".."):
        print(f"\033[1;31mError: Invalid profile name '{name}'. Use only letters, numbers, hyphens, and underscores.\033[0m")
        sys.exit(1)

def ensure_profiles_dir():
    if not os.path.isdir(PROFILES_DIR):
        os.makedirs(PROFILES_DIR, mode=0o700, exist_ok=True)
    else:
        try:
            os.chmod(PROFILES_DIR, 0o700)
        except OSError:
            pass

def secure_file(path):
    """Enforce strict 0600 permission on token files for security."""
    if os.path.isfile(path):
        try:
            os.chmod(path, 0o600)
        except OSError:
            pass

def parse_jwt(token_str):
    try:
        parts = token_str.split(".")
        if len(parts) < 2:
            return {}
        payload_b64 = parts[1]
        payload_b64 += "=" * ((4 - len(payload_b64) % 4) % 4)
        payload_json = base64.urlsafe_b64decode(payload_b64.encode("utf-8")).decode("utf-8")
        return json.loads(payload_json)
    except Exception:
        return {}

def inspect_token_file(token_path):
    """Returns dict with email, exp, is_expired, expiry_str."""
    if not os.path.isfile(token_path):
        return {"exists": False, "email": None, "is_expired": True, "expiry_str": "No Token"}
    try:
        with open(token_path, "r", encoding="utf-8") as f:
            data = json.load(f)
        id_token = data.get("id_token")
        if not id_token:
            return {"exists": True, "email": "Unknown (No id_token)", "is_expired": False, "expiry_str": "Unknown"}
        
        jwt_data = parse_jwt(id_token)
        email = jwt_data.get("email") or "Unknown"
        exp = jwt_data.get("exp")
        
        if exp:
            now = time.time()
            is_expired = now > exp
            exp_dt = datetime.fromtimestamp(exp).strftime("%Y-%m-%d %H:%M")
            expiry_str = f"Expired at {exp_dt}" if is_expired else f"Expires at {exp_dt}"
        else:
            is_expired = False
            expiry_str = "No Expiry Field"

        return {
            "exists": True,
            "email": email,
            "exp": exp,
            "is_expired": is_expired,
            "expiry_str": expiry_str
        }
    except Exception as e:
        return {"exists": True, "email": f"Corrupted Token ({e})", "is_expired": True, "expiry_str": "Error"}

def auto_backup_current():
    ensure_profiles_dir()
    info = inspect_token_file(TOKEN_FILE)
    current_email = info.get("email")
    if not current_email or "Unknown" in current_email or "Corrupted" in current_email:
        return

    # Check if this token is already saved under any profile
    for p in os.listdir(PROFILES_DIR):
        p_path = os.path.join(PROFILES_DIR, p, "antigravity-oauth-token")
        p_info = inspect_token_file(p_path)
        if p_info.get("email") == current_email:
            return

    auto_name = current_email.split("@")[0]
    validate_name(auto_name)
    target_dir = os.path.join(PROFILES_DIR, auto_name)
    os.makedirs(target_dir, mode=0o700, exist_ok=True)
    dest_token = os.path.join(target_dir, "antigravity-oauth-token")
    shutil.copy2(TOKEN_FILE, dest_token)
    secure_file(dest_token)
    print(f"\033[1;33m[Auto-Backup] Current active account saved as profile '{auto_name}'.\033[0m")

def cmd_current(args):
    info = inspect_token_file(TOKEN_FILE)
    if info.get("exists") and info.get("email"):
        status_tag = "\033[1;31m[EXPIRED / NEEDS REFRESH]\033[0m" if info["is_expired"] else "\033[1;32m[VALID]\033[0m"
        print(f"Current logged-in account: \033[1;34m{info['email']}\033[0m {status_tag}")
        print(f"Token status: {info['expiry_str']}")
    else:
        print("\033[1;33mNo active Antigravity session or token not found.\033[0m")

def cmd_list(args):
    ensure_profiles_dir()
    current_info = inspect_token_file(TOKEN_FILE)
    current_email = current_info.get("email")
    profiles = sorted(os.listdir(PROFILES_DIR))
    
    print("\n" + "=" * 70)
    print(f" \033[1mAntigravity Profiles Directory\033[0m ({PROFILES_DIR})")
    print("=" * 70)
    
    if not profiles:
        print("  (No profiles saved yet. Run 'agy-auth new <name>' to create one)")
    else:
        for idx, p in enumerate(profiles, 1):
            p_path = os.path.join(PROFILES_DIR, p, "antigravity-oauth-token")
            p_info = inspect_token_file(p_path)
            is_active = (current_email and p_info.get("email") == current_email)
            
            prefix = "\033[1;32m* \033[0m" if is_active else "  "
            active_badge = " \033[1;32m(ACTIVE)\033[0m" if is_active else ""
            status_color = "\033[31m" if p_info.get("is_expired") else "\033[32m"
            status_text = f"{status_color}[{'EXP' if p_info.get('is_expired') else 'OK'}]\033[0m"
            
            email = p_info.get("email") or "Unknown"
            print(f"{prefix}[{idx}] \033[1m{p:<15}\033[0m {status_text} {email:<30}{active_badge}")
            
    print("=" * 70)
    if current_email:
        print(f"Current active session: \033[1;34m{current_email}\033[0m\n")
    else:
        print("No active session currently loaded.\n")

def cmd_new(args):
    ensure_profiles_dir()
    name = args.name.strip()
    validate_name(name)
    target_dir = os.path.join(PROFILES_DIR, name)

    if os.path.isdir(target_dir):
        print(f"\033[1;31mError: Profile '{name}' already exists!\033[0m")
        print(f"Use 'agy-auth remove {name}' to delete it first or choose another name.")
        sys.exit(1)

    # 1. Backup current session
    auto_backup_current()

    # 2. Temporarily remove token file to trigger fresh login
    if os.path.isfile(TOKEN_FILE):
        os.remove(TOKEN_FILE)

    print(f"\n\033[1;34m>>> Launching Antigravity authentication for profile '{name}'...\033[0m")
    print("Please complete login in your browser/terminal.\n")

    # 3. Launch agy
    try:
        subprocess.run(["agy"], check=False)
    except FileNotFoundError:
        print("\033[1;31mError: 'agy' command not found in PATH.\033[0m")
        sys.exit(1)

    # 4. Check if token was created
    info = inspect_token_file(TOKEN_FILE)
    if not info.get("exists") or not info.get("email"):
        print(f"\n\033[1;31mLogin was cancelled or failed. Profile '{name}' was not created.\033[0m")
        sys.exit(1)

    # 5. Save into profile with strict 0600 permissions
    os.makedirs(target_dir, mode=0o700, exist_ok=True)
    dest_token = os.path.join(target_dir, "antigravity-oauth-token")
    shutil.copy2(TOKEN_FILE, dest_token)
    secure_file(dest_token)
    secure_file(TOKEN_FILE)
    
    print("\n" + "=" * 65)
    print(f"\033[1;32m✓ Profile '{name}' successfully created and active!\033[0m")
    print(f"Account: \033[1;34m{info['email']}\033[0m")
    print("=" * 65 + "\n")

def cmd_save(args):
    ensure_profiles_dir()
    name = args.name.strip()
    validate_name(name)
    if not os.path.isfile(TOKEN_FILE):
        print(f"\033[1;31mError: No current active token found at {TOKEN_FILE}\033[0m")
        sys.exit(1)
        
    info = inspect_token_file(TOKEN_FILE)
    target_dir = os.path.join(PROFILES_DIR, name)
    os.makedirs(target_dir, mode=0o700, exist_ok=True)
    
    dest_token = os.path.join(target_dir, "antigravity-oauth-token")
    shutil.copy2(TOKEN_FILE, dest_token)
    secure_file(dest_token)
        
    print(f"\033[1;32m✓ Profile '{name}' saved successfully!\033[0m")
    if info.get("email"):
        print(f"Linked Account: \033[1;34m{info['email']}\033[0m")

def cmd_rename(args):
    ensure_profiles_dir()
    old_name = args.old_name.strip()
    new_name = args.new_name.strip()
    validate_name(old_name)
    validate_name(new_name)
    
    old_dir = os.path.join(PROFILES_DIR, old_name)
    new_dir = os.path.join(PROFILES_DIR, new_name)

    if not os.path.isdir(old_dir):
        print(f"\033[1;31mError: Profile '{old_name}' does not exist.\033[0m")
        sys.exit(1)

    if os.path.isdir(new_dir):
        print(f"\033[1;31mError: Target profile name '{new_name}' already exists.\033[0m")
        sys.exit(1)

    os.rename(old_dir, new_dir)
    print(f"\033[1;32m✓ Profile '{old_name}' renamed to '{new_name}' successfully!\033[0m")

def cmd_use(args):
    ensure_profiles_dir()
    profiles = sorted(os.listdir(PROFILES_DIR))
    
    if not profiles:
        print("\033[1;33mNo profiles found. Run 'agy-auth new <name>' to create one first.\033[0m")
        sys.exit(1)

    name = args.name.strip() if args.name else None

    # Interactive selector if name is not provided
    if not name:
        current_info = inspect_token_file(TOKEN_FILE)
        current_email = current_info.get("email")
        print("\n\033[1mSelect a profile to switch to:\033[0m")
        for idx, p in enumerate(profiles, 1):
            p_path = os.path.join(PROFILES_DIR, p, "antigravity-oauth-token")
            p_info = inspect_token_file(p_path)
            is_active = (current_email and p_info.get("email") == current_email)
            badge = " \033[1;32m(ACTIVE)\033[0m" if is_active else ""
            print(f"  \033[1m[{idx}]\033[0m {p:<15} ({p_info.get('email', 'Unknown')}){badge}")
        
        try:
            choice = input("\nEnter number or profile name (or 'q' to cancel): ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            sys.exit(0)
            
        if not choice or choice.lower() == 'q':
            print("Cancelled.")
            sys.exit(0)
        if choice.isdigit() and 1 <= int(choice) <= len(profiles):
            name = profiles[int(choice) - 1]
        else:
            name = choice

    validate_name(name)
    profile_dir = os.path.join(PROFILES_DIR, name)
    profile_token = os.path.join(profile_dir, "antigravity-oauth-token")
    
    if not os.path.isfile(profile_token):
        print(f"\033[1;31mError: Profile '{name}' does not exist.\033[0m")
        print("Run 'agy-auth list' to see available profiles.")
        sys.exit(1)
        
    auto_backup_current()

    # Apply profile
    shutil.copy2(profile_token, TOKEN_FILE)
    secure_file(TOKEN_FILE)
    
    info = inspect_token_file(TOKEN_FILE)
    print(f"\033[1;32m✓ Switched successfully to profile '{name}'!\033[0m")
    if info.get("email"):
        status_tag = " \033[1;31m(Expired / will refresh on next request)\033[0m" if info["is_expired"] else ""
        print(f"Active Account: \033[1;34m{info['email']}\033[0m{status_tag}")

def cmd_remove(args):
    ensure_profiles_dir()
    name = args.name.strip()
    validate_name(name)
    profile_dir = os.path.join(PROFILES_DIR, name)
    
    if not os.path.isdir(profile_dir):
        print(f"\033[1;31mError: Profile '{name}' does not exist.\033[0m")
        sys.exit(1)

    # Check if active
    p_path = os.path.join(profile_dir, "antigravity-oauth-token")
    p_info = inspect_token_file(p_path)
    current_info = inspect_token_file(TOKEN_FILE)
    
    if current_info.get("email") and p_info.get("email") == current_info.get("email"):
        print(f"\033[1;33mWarning: Profile '{name}' is currently ACTIVE.\033[0m")
        if not getattr(args, "force", False):
            try:
                confirm = input("Are you sure you want to delete the active profile? [y/N]: ").strip().lower()
            except (KeyboardInterrupt, EOFError):
                print("\nCancelled.")
                sys.exit(0)
            if confirm not in ("y", "yes"):
                print("Cancelled deletion.")
                sys.exit(0)

    shutil.rmtree(profile_dir)
    print(f"\033[1;32m✓ Profile '{name}' removed successfully.\033[0m")

def cmd_logout(args):
    if os.path.isfile(TOKEN_FILE):
        os.remove(TOKEN_FILE)
        print("\033[1;32m✓ Active session cleared (Logged out). Next 'agy' run will ask to log in.\033[0m")
    else:
        print("No active session to clear.")

def cmd_export(args):
    ensure_profiles_dir()
    profiles = sorted(os.listdir(PROFILES_DIR))
    if not profiles:
        print("\033[1;33mNo profiles found to export.\033[0m")
        sys.exit(1)

    target_profiles = []
    if args.name:
        name = args.name.strip()
        validate_name(name)
        p_dir = os.path.join(PROFILES_DIR, name)
        if not os.path.isdir(p_dir):
            print(f"\033[1;31mError: Profile '{name}' does not exist.\033[0m")
            sys.exit(1)
        target_profiles.append(name)
    else:
        target_profiles = profiles

    output_path = args.output
    if not output_path:
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        if args.name:
            output_path = f"agy-profile-{args.name}-{timestamp}.json"
        else:
            output_path = f"agy-profiles-backup-{timestamp}.json"

    export_data = {
        "version": 1,
        "exported_at": datetime.now().isoformat(),
        "profiles": {}
    }

    count = 0
    for p in target_profiles:
        p_token_path = os.path.join(PROFILES_DIR, p, "antigravity-oauth-token")
        if os.path.isfile(p_token_path):
            try:
                with open(p_token_path, "r", encoding="utf-8") as f:
                    token_content = json.load(f)
                info = inspect_token_file(p_token_path)
                export_data["profiles"][p] = {
                    "token": token_content,
                    "email": info.get("email")
                }
                count += 1
            except Exception as e:
                print(f"\033[1;33mWarning: Failed to read token for profile '{p}': {e}\033[0m")

    if not export_data["profiles"]:
        print("\033[1;31mError: No valid profile tokens found to export.\033[0m")
        sys.exit(1)

    try:
        with open(output_path, "w", encoding="utf-8") as f:
            json.dump(export_data, f, indent=2)
        secure_file(output_path)
        print("\n" + "=" * 65)
        print(f"\033[1;32m✓ Successfully exported {count} profile(s) to:\033[0m {output_path}")
        print("Profiles included:")
        for p, p_data in export_data["profiles"].items():
            print(f"  • \033[1m{p:<15}\033[0m ({p_data.get('email', 'Unknown')})")
        print("=" * 65 + "\n")
    except Exception as e:
        print(f"\033[1;31mError writing export file: {e}\033[0m")
        sys.exit(1)

def cmd_import(args):
    ensure_profiles_dir()
    filepath = args.file.strip()
    if not os.path.isfile(filepath):
        print(f"\033[1;31mError: File '{filepath}' does not exist.\033[0m")
        sys.exit(1)

    try:
        with open(filepath, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception as e:
        print(f"\033[1;31mError: Invalid JSON file '{filepath}': {e}\033[0m")
        sys.exit(1)

    # Validate structure
    profiles_data = {}
    if isinstance(data, dict):
        if "profiles" in data and isinstance(data["profiles"], dict):
            # Standard agy-auth export format
            profiles_data = data["profiles"]
        elif "id_token" in data or "refresh_token" in data:
            # Single raw token file import
            import_name = args.as_name.strip() if args.as_name else None
            if not import_name:
                jwt_data = parse_jwt(data.get("id_token", ""))
                email = jwt_data.get("email")
                if email:
                    import_name = email.split("@")[0]
                else:
                    import_name = "imported_profile"
            profiles_data = {
                import_name: {
                    "token": data
                }
            }
        else:
            print(f"\033[1;31mError: Unrecognized profile format in '{filepath}'.\033[0m")
            sys.exit(1)
    else:
        print(f"\033[1;31mError: Unexpected JSON content in '{filepath}'.\033[0m")
        sys.exit(1)

    # Filter if user specified a single profile to import from package
    if args.name:
        filter_name = args.name.strip()
        if filter_name not in profiles_data:
            print(f"\033[1;31mError: Profile '{filter_name}' not found in '{filepath}'.\033[0m")
            print(f"Available profiles in file: {', '.join(profiles_data.keys())}")
            sys.exit(1)
        profiles_data = {filter_name: profiles_data[filter_name]}

    imported_count = 0
    print("\n" + "=" * 65)
    print(f" \033[1mImporting Profiles from {filepath}\033[0m")
    print("=" * 65)

    for p_name, p_info in profiles_data.items():
        dest_name = args.as_name.strip() if (args.as_name and len(profiles_data) == 1) else p_name
        try:
            validate_name(dest_name)
        except SystemExit:
            print(f"\033[1;31mSkipping invalid profile name '{dest_name}'.\033[0m")
            continue

        target_dir = os.path.join(PROFILES_DIR, dest_name)
        token_content = p_info.get("token") if isinstance(p_info, dict) else p_info

        if not isinstance(token_content, dict):
            print(f"\033[1;33mSkipping '{dest_name}': invalid token data.\033[0m")
            continue

        if os.path.isdir(target_dir) and not getattr(args, "force", False):
            print(f"\033[1;33mProfile '{dest_name}' already exists. Overwrite? [y/N]: \033[0m", end="")
            try:
                choice = input().strip().lower()
            except (KeyboardInterrupt, EOFError):
                print("\nCancelled.")
                sys.exit(0)
            if choice not in ("y", "yes"):
                print(f"Skipping profile '{dest_name}'.")
                continue

        os.makedirs(target_dir, mode=0o700, exist_ok=True)
        dest_token = os.path.join(target_dir, "antigravity-oauth-token")
        try:
            with open(dest_token, "w", encoding="utf-8") as f:
                json.dump(token_content, f, indent=2)
            secure_file(dest_token)
            
            info = inspect_token_file(dest_token)
            email_str = info.get("email") or "Unknown"
            print(f"  \033[1;32m✓\033[0m Imported \033[1m{dest_name:<15}\033[0m ({email_str})")
            imported_count += 1
        except Exception as e:
            print(f"  \033[1;31m✗\033[0m Failed to write profile '{dest_name}': {e}")

    print("=" * 65)
    print(f"\033[1;32mImport finished: {imported_count} profile(s) imported successfully.\033[0m\n")

def get_summaries_db_conn():
    if not os.path.isfile(SUMMARIES_DB):
        return None
    return sqlite3.connect(SUMMARIES_DB)

def list_recent_conversations(limit=20):
    conn = get_summaries_db_conn()
    if not conn:
        return []
    try:
        cur = conn.cursor()
        cur.execute("""
            SELECT conversation_id, title, preview, last_modified_time, workspace_uris
            FROM conversation_summaries
            ORDER BY last_modified_time DESC
            LIMIT ?
        """, (limit,))
        return cur.fetchall()
    except Exception:
        return []
    finally:
        conn.close()

def cmd_conv_list(args):
    rows = list_recent_conversations(limit=getattr(args, "limit", 20) or 20)
    print("\n" + "=" * 90)
    print(" \033[1mRecent Antigravity Conversations\033[0m")
    print("=" * 90)
    if not rows:
        print("  (No conversations found)")
    else:
        for idx, (cid, title, preview, last_mod, ws_uris) in enumerate(rows, 1):
            short_title = (title or "Untitled")[:40]
            time_str = str(last_mod)[:19] if last_mod else "Unknown"
            print(f"  [{idx:2d}] \033[1m{cid}\033[0m")
            print(f"       \033[36mTitle:\033[0m {short_title}  \033[33m| Time:\033[0m {time_str}")
            if preview:
                short_prev = preview.replace("\n", " ").strip()[:70]
                print(f"       \033[90mPreview: {short_prev}...\033[0m")
            print()
    print("=" * 90)

def cmd_conv_export(args):
    conn = get_summaries_db_conn()
    if not conn:
        print(f"\033[1;31mError: Conversation database not found at {SUMMARIES_DB}\033[0m")
        sys.exit(1)

    cid = None
    if getattr(args, "last", False):
        rows = list_recent_conversations(limit=1)
        if not rows:
            print("\033[1;31mError: No conversation found to export.\033[0m")
            sys.exit(1)
        cid = rows[0][0]
    elif getattr(args, "id", None):
        cid = args.id.strip()
    else:
        # Interactive selector
        rows = list_recent_conversations(limit=10)
        if not rows:
            print("\033[1;31mError: No conversations found to export.\033[0m")
            sys.exit(1)
        print("\nSelect conversation to export:")
        for idx, (c_id, title, preview, last_mod, _) in enumerate(rows, 1):
            t_str = (title or "Untitled")[:45]
            time_str = str(last_mod)[:19] if last_mod else ""
            print(f"  [{idx}] \033[1m{c_id}\033[0m - {t_str} ({time_str})")
        print()
        try:
            choice = input("Enter number or Conversation ID (or 'q' to cancel): ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            sys.exit(0)
        if not choice or choice.lower() == 'q':
            print("Cancelled.")
            sys.exit(0)
        if choice.isdigit() and 1 <= int(choice) <= len(rows):
            cid = rows[int(choice) - 1][0]
        else:
            cid = choice

    # Validate conversation DB exists
    conv_db_path = os.path.join(CONVERSATIONS_DIR, f"{cid}.db")
    if not os.path.isfile(conv_db_path):
        print(f"\033[1;31mError: Conversation database not found: {conv_db_path}\033[0m")
        sys.exit(1)

    # Fetch summary row
    cur = conn.cursor()
    cur.execute("PRAGMA table_info(conversation_summaries)")
    columns = [col[1] for col in cur.fetchall()]

    cur.execute("SELECT * FROM conversation_summaries WHERE conversation_id = ?", (cid,))
    row = cur.fetchone()
    conn.close()

    summary_dict = {}
    if row:
        for col_name, val in zip(columns, row):
            if isinstance(val, (bytes, bytearray)):
                summary_dict[col_name] = base64.b64encode(val).decode("utf-8")
                summary_dict[f"_{col_name}_is_b64"] = True
            else:
                summary_dict[col_name] = val

    manifest = {
        "version": 1,
        "format": "antigravity-conversation",
        "conversation_id": cid,
        "exported_at": datetime.now().isoformat(),
        "summary": summary_dict
    }

    output_path = getattr(args, "output", None)
    if not output_path:
        safe_title = re.sub(r'[^a-zA-Z0-9_\-]', '_', (summary_dict.get("title") or "conversation"))[:25].strip('_')
        output_path = f"agy-conv-{safe_title or 'session'}-{cid[:8]}.agyconv"

    print(f"\nExporting conversation \033[1m{cid}\033[0m...")
    brain_path = os.path.join(BRAIN_DIR, cid)

    with tempfile.TemporaryDirectory() as tmpdir:
        # Write manifest
        manifest_file = os.path.join(tmpdir, "manifest.json")
        with open(manifest_file, "w", encoding="utf-8") as f:
            json.dump(manifest, f, indent=2)

        # Copy conv db
        shutil.copy2(conv_db_path, os.path.join(tmpdir, f"{cid}.db"))

        # Copy brain if exists
        tmp_brain = os.path.join(tmpdir, "brain")
        if os.path.isdir(brain_path):
            shutil.copytree(brain_path, tmp_brain)

        # Create tar.gz package
        with tarfile.open(output_path, "w:gz") as tar:
            tar.add(manifest_file, arcname="manifest.json")
            tar.add(os.path.join(tmpdir, f"{cid}.db"), arcname=f"{cid}.db")
            if os.path.isdir(tmp_brain):
                tar.add(tmp_brain, arcname="brain")

    file_size_kb = os.path.getsize(output_path) / 1024
    print(f"\033[1;32m✓ Successfully exported conversation package:\033[0m \033[1m{output_path}\033[0m ({file_size_kb:.1f} KB)")
    print(f"Title: {summary_dict.get('title', 'Untitled')}")
    print(f"To import on another machine: \033[1m這agy-auth conv import {output_path}\033[0m\n".replace("這", ""))

def cmd_conv_import(args):
    filepath = args.file.strip()
    if not os.path.isfile(filepath):
        print(f"\033[1;31mError: File '{filepath}' does not exist.\033[0m")
        sys.exit(1)

    with tempfile.TemporaryDirectory() as tmpdir:
        try:
            with tarfile.open(filepath, "r:*") as tar:
                tar.extractall(path=tmpdir)
        except Exception as e:
            print(f"\033[1;31mError extracting conversation package '{filepath}': {e}\033[0m")
            sys.exit(1)

        manifest_file = os.path.join(tmpdir, "manifest.json")
        if not os.path.isfile(manifest_file):
            print(f"\033[1;31mError: Invalid conversation package (manifest.json missing).\033[0m")
            sys.exit(1)

        with open(manifest_file, "r", encoding="utf-8") as f:
            manifest = json.load(f)

        cid = manifest.get("conversation_id")
        if not cid:
            print("\033[1;31mError: Invalid manifest (missing conversation_id).\033[0m")
            sys.exit(1)

        imported_db = os.path.join(tmpdir, f"{cid}.db")
        if not os.path.isfile(imported_db):
            print(f"\033[1;31mError: Missing database file '{cid}.db' in package.\033[0m")
            sys.exit(1)

        # Target paths
        os.makedirs(CONVERSATIONS_DIR, exist_ok=True)
        dest_db = os.path.join(CONVERSATIONS_DIR, f"{cid}.db")
        dest_brain = os.path.join(BRAIN_DIR, cid)

        if os.path.isfile(dest_db) and not getattr(args, "force", False):
            print(f"\033[1;33mConversation '{cid}' already exists in this environment. Overwrite? [y/N]: \033[0m", end="")
            try:
                choice = input().strip().lower()
            except (KeyboardInterrupt, EOFError):
                print("\nCancelled.")
                sys.exit(0)
            if choice not in ("y", "yes"):
                print("Import cancelled.")
                sys.exit(0)

        # Copy conversation DB
        shutil.copy2(imported_db, dest_db)

        # Copy brain directory if exists
        tmp_brain = os.path.join(tmpdir, "brain")
        if os.path.isdir(tmp_brain):
            if os.path.exists(dest_brain):
                shutil.rmtree(dest_brain)
            shutil.copytree(tmp_brain, dest_brain)

        # Merge / Upsert into conversation_summaries.db
        summary_dict = manifest.get("summary", {})
        if summary_dict and os.path.isfile(SUMMARIES_DB):
            conn = sqlite3.connect(SUMMARIES_DB)
            cur = conn.cursor()
            cur.execute("PRAGMA table_info(conversation_summaries)")
            existing_cols = {col[1] for col in cur.fetchall()}

            cols_to_insert = []
            vals_to_insert = []
            for k, v in summary_dict.items():
                if k.startswith("_"):
                    continue
                if k in existing_cols:
                    cols_to_insert.append(k)
                    if summary_dict.get(f"_{k}_is_b64"):
                        vals_to_insert.append(base64.b64decode(v.encode("utf-8")))
                    else:
                        vals_to_insert.append(v)

            if cols_to_insert:
                placeholders = ", ".join(["?"] * len(cols_to_insert))
                col_names = ", ".join([f"`{c}`" for c in cols_to_insert])
                sql = f"INSERT OR REPLACE INTO conversation_summaries ({col_names}) VALUES ({placeholders})"
                cur.execute(sql, vals_to_insert)
                conn.commit()
            conn.close()

    title = summary_dict.get("title") or "Untitled"
    print(f"\n\033[1;32m✓ Successfully imported conversation!\033[0m")
    print(f"Conversation ID: \033[1m{cid}\033[0m")
    print(f"Title: {title}")
    print(f"\nTo resume this conversation, run:")
    print(f"  \033[1;36magy-auth conv resume {cid}\033[0m")
    print(f"  or: \033[1;36magy --conversation {cid}\033[0m\n")

def cmd_conv_resume(args):
    cid = None
    if getattr(args, "last", False):
        rows = list_recent_conversations(limit=1)
        if not rows:
            print("\033[1;31mError: No conversation found to resume.\033[0m")
            sys.exit(1)
        cid = rows[0][0]
    elif getattr(args, "id", None):
        cid = args.id.strip()
    else:
        rows = list_recent_conversations(limit=10)
        if not rows:
            print("\033[1;31mError: No conversations found to resume.\033[0m")
            sys.exit(1)
        print("\nSelect conversation to resume:")
        for idx, (c_id, title, preview, last_mod, _) in enumerate(rows, 1):
            t_str = (title or "Untitled")[:45]
            time_str = str(last_mod)[:19] if last_mod else ""
            print(f"  [{idx}] \033[1m{c_id}\033[0m - {t_str} ({time_str})")
        print()
        try:
            choice = input("Enter number or Conversation ID (or 'q' to cancel): ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            sys.exit(0)
        if not choice or choice.lower() == 'q':
            print("Cancelled.")
            sys.exit(0)
        if choice.isdigit() and 1 <= int(choice) <= len(rows):
            cid = rows[int(choice) - 1][0]
        else:
            cid = choice

    conv_db = os.path.join(CONVERSATIONS_DIR, f"{cid}.db")
    if not os.path.isfile(conv_db):
        print(f"\033[1;31mError: Conversation database '{cid}.db' not found.\033[0m")
        sys.exit(1)

    agy_bin = shutil.which("agy") or shutil.which("agy.cmd") or shutil.which("agy.exe")
    if not agy_bin:
        print("\033[1;31mError: 'agy' command not found in PATH.\033[0m")
        sys.exit(1)

    print(f"\033[1;32mResuming conversation {cid}...\033[0m\n")
    if sys.platform == "win32":
        try:
            sys.exit(subprocess.call([agy_bin, "--conversation", cid]))
        except KeyboardInterrupt:
            sys.exit(0)
    else:
        os.execv(agy_bin, [agy_bin, "--conversation", cid])

def main():
    parser = argparse.ArgumentParser(
        description="Antigravity Profile Switcher & Conversation Manager CLI (agy-auth)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  agy-auth new work              # Create & login directly into 'work'
  agy-auth use                   # Interactive menu to select profile
  agy-auth use work              # Switch directly to 'work'
  agy-auth list                  # View all profiles & token expiry status
  agy-auth rename work office    # Rename profile
  agy-auth current               # Show current active account
  agy-auth remove old-profile    # Safely delete a profile
  agy-auth export -o backup.json # Export all profiles to a JSON file
  agy-auth import backup.json    # Import profiles from JSON file

Conversation Management:
  agy-auth conv list             # List recent conversations
  agy-auth conv export           # Interactively select conversation to export
  agy-auth conv export --last    # Export most recent conversation
  agy-auth conv export <id>      # Export specific conversation to package (.agyconv)
  agy-auth conv import file.agyconv # Import conversation package
  agy-auth conv resume [id]      # Resume conversation with agy
"""
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # current
    subparsers.add_parser("current", help="Show currently logged in user & token health")
    
    # list
    subparsers.add_parser("list", help="List all profiles with status and expiry")
    
    # new
    p_new = subparsers.add_parser("new", help="Add/login a new profile directly")
    p_new.add_argument("name", help="Profile name (e.g. work, personal)")

    # rename
    p_rename = subparsers.add_parser("rename", help="Rename an existing profile")
    p_rename.add_argument("old_name", help="Current profile name")
    p_rename.add_argument("new_name", help="New profile name")

    # save
    p_save = subparsers.add_parser("save", help="Save current active session under a profile name")
    p_save.add_argument("name", help="Profile name")

    # use
    p_use = subparsers.add_parser("use", help="Switch profile (interactive if name omitted)")
    p_use.add_argument("name", nargs="?", default=None, help="Profile name (optional)")

    # remove
    p_remove = subparsers.add_parser("remove", help="Remove a saved profile")
    p_remove.add_argument("name", help="Profile name to remove")
    p_remove.add_argument("-f", "--force", action="store_true", help="Skip confirmation prompt")

    # export
    p_export = subparsers.add_parser("export", help="Export one or all profiles to a JSON file")
    p_export.add_argument("name", nargs="?", default=None, help="Profile name to export (optional, exports all if omitted)")
    p_export.add_argument("-o", "--output", default=None, help="Output JSON file path (optional)")

    # import
    p_import = subparsers.add_parser("import", help="Import profiles from a JSON file")
    p_import.add_argument("file", help="Path to JSON file to import")
    p_import.add_argument("--name", default=None, help="Import only a specific profile from package")
    p_import.add_argument("--as-name", default=None, help="Rename imported profile")
    p_import.add_argument("-f", "--force", action="store_true", help="Overwrite existing profiles without prompt")

    # logout
    subparsers.add_parser("logout", help="Log out current active session")

    # conv (Conversation management)
    p_conv = subparsers.add_parser("conv", help="Manage, export, import, and resume conversations")
    conv_sub = p_conv.add_subparsers(dest="conv_command", required=True)

    # conv list
    p_conv_l = conv_sub.add_parser("list", help="List recent conversations")
    p_conv_l.add_argument("-n", "--limit", type=int, default=20, help="Number of conversations to display (default: 20)")

    # conv export
    p_conv_e = conv_sub.add_parser("export", help="Export conversation package (.agyconv)")
    p_conv_e.add_argument("id", nargs="?", default=None, help="Conversation ID to export (optional)")
    p_conv_e.add_argument("--last", action="store_true", help="Export the most recent conversation")
    p_conv_e.add_argument("-o", "--output", default=None, help="Output file path (.agyconv)")

    # conv import
    p_conv_i = conv_sub.add_parser("import", help="Import conversation package (.agyconv)")
    p_conv_i.add_argument("file", help="Path to conversation package file")
    p_conv_i.add_argument("-f", "--force", action="store_true", help="Overwrite without confirmation prompt")

    # conv resume
    p_conv_r = conv_sub.add_parser("resume", help="Resume a conversation with agy")
    p_conv_r.add_argument("id", nargs="?", default=None, help="Conversation ID to resume (optional)")
    p_conv_r.add_argument("--last", action="store_true", help="Resume the most recent conversation")

    args = parser.parse_args()

    commands = {
        "current": cmd_current,
        "list": cmd_list,
        "new": cmd_new,
        "rename": cmd_rename,
        "save": cmd_save,
        "use": cmd_use,
        "remove": cmd_remove,
        "logout": cmd_logout,
        "export": cmd_export,
        "import": cmd_import,
        "conv": lambda a: {
            "list": cmd_conv_list,
            "export": cmd_conv_export,
            "import": cmd_conv_import,
            "resume": cmd_conv_resume,
        }[a.conv_command](a),
    }

    commands[args.command](args)

if __name__ == "__main__":
    main()

